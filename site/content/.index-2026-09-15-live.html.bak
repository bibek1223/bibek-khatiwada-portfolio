            <div class="dashboard-actions">
              <a class="btn btn-primary" href="#work">Explore case studies <span aria-hidden="true">→</span></a>
              <a class="btn btn-secondary" href="https://wa.me/9779860411440" target="_blank" rel="noreferrer">Chat on WhatsApp</a>
            </div>
            <div class="dashboard-proofline">
              <span>Managed 50+ member delivery teams</span>
              <span>Built SEO tools and workflows</span>
            </div>
          </div>
          <aside class="dashboard-photo-card">
            <img src="assets/bibek-khatiwada-profile.webp" alt="Bibek Khatiwada, SEO strategist" loading="eager">
            <div class="dashboard-label"><strong>21.2M+ clicks</strong><span>Search Console-led growth</span></div>
